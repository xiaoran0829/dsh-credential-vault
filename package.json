{
  "name": "dsh-credential-vault",
  "version": "1.0.1",
  "type": "module",
  "description": "DSH Web 凭证库：本地加密保存密码与 API Token，浏览器查看需主密码，Agent 可通过 vaultctl 查阅。｜ Credential vault for DSH Web: encrypted local store for passwords and API tokens, master-password-gated browser view, agent CLI access.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./vault": "./vault.js",
    "./vaultctl": "./vaultctl.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "vault.js",
    "vaultctl.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoran0829/dsh-credential-vault.git"
  },
  "homepage": "https://github.com/xiaoran0829/dsh-credential-vault#readme",
  "bugs": {
    "url": "https://github.com/xiaoran0829/dsh-credential-vault/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "vault",
    "credentials",
    "password-manager",
    "api-token"
  ]
}
